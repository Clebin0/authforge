# PostgreSQL
POSTGRES_DB=authforge
POSTGRES_USER=authforge
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=jdbc:postgresql://db:5432/authforge
DATABASE_USERNAME=authforge
DATABASE_PASSWORD=replace-with-a-long-random-database-password

# Generate with PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_OF_64_RANDOM_BYTES
JWT_ISSUER=authforge
JWT_ACCESS_TOKEN_TTL=PT10M
JWT_REFRESH_TOKEN_TTL=P7D
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: set BOTH to create the first ADMIN account at startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
